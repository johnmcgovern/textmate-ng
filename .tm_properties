# Settings
windowTitleProject   = '${projectDirectory:+ — ${projectDirectory/^.*\///}}'
windowTitleFramework = '${TM_DIRECTORY/.*\/Frameworks\/([^\/]+)\/.*|.*/${1:+ ($1)}/}'
windowTitle          = '$TM_DISPLAYNAME$windowTitleFramework$windowTitleProject$windowTitleSCM'

excludeDirectoriesInFileChooser  = '{bin/CxxTest,build,SyntaxMate.tmBundle}'
excludeDirectoriesInFolderSearch = '{bin/CxxTest,build,SyntaxMate.tmBundle}'

# Variables
TM_ORGANIZATION_NAME = 'MacroMates'

TM_TODO_IGNORE       = '/(build|CxxTest|PlugIns|vendor)/|\.(md|html)$'
TM_FRAMEWORKS        = 'authorization buffer BundleEditor BundleEditor BundleMenu bundles BundlesManager cf command CommitWindow crash CrashReporter document DocumentWindow editor encoding file FileBrowser Find HTMLOutput HTMLOutputWindow io layout MenuBuilder network ns OakAppKit OakCommand OakDebug OakFilterList OakFoundation OakSystem OakTabBarView OakTextView parse plist Preferences regexp scm scope selection settings SoftwareUpdate text theme undo updater version'
# Points at ide/gen/include/<fw>/<fw>/*.h, the Xcode seed's generated header farm
# (ide/seed_xcodeproj.rb GEN_INCLUDE) — run ide/extract_specs.rb + ide/seed_xcodeproj.rb
# once to populate it before relying on this for in-editor diagnostics/completion.
TM_FRAMEWORK_INCLUDE = '${TM_FRAMEWORKS/\w+/-I"$CWD\/ide\/gen\/include\/$0"/g}'
TM_CXX_FLAGS         = '$TM_CXX_FLAGS    -I"$CWD/Shared/include" ${TM_FRAMEWORK_INCLUDE}'
TM_OBJCXX_FLAGS      = '$TM_OBJCXX_FLAGS -I"$CWD/Shared/include" ${TM_FRAMEWORK_INCLUDE}'

TM_ISSUE_URL         = 'https://github.com/textmate/textmate/issues/%s'

[ 'source.c++, source.objc++' ]
tabSize          = 3
softTabs         = false
TM_C_POINTER     = "* "

[ *.h ]
fileType         = 'source.objc++'

[ attr.untitled ]
fileType         = 'source.objc++'

[ tests/t_*.{cc,mm} ]
scopeAttributes  = 'attr.test.cxxtest'

[ tests/gui_*.mm ]
GUI_TESTS        = '${TM_FILENAME/^gui_(.*)\.mm$/$1/}'
