<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS app extensions must be sandboxed; the Quick Look host will not run
	     an unsandboxed one. Checked against every preview extension installed on
	     a real machine, Apple's and third parties' alike (LibreOffice's is the
	     useful comparison — Developer ID, not App Store, exactly this app's
	     distribution): all of them carry this. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- The file being previewed. The host hands over access to that one file;
	     this is the entitlement that lets the extension accept it. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>

	<!-- Exactly the two trees this reads, and no more.
	     This was `/` — the whole home folder — until passwd_entry() learned to
	     tell a *missing* home from an unreadable one (io/src/path.cc). Until
	     then, granting only these two left access("/Users/<you>", R_OK) denied,
	     which passwd_entry() read as a missing home and answered with a modal
	     alert on every preview. The broad grant was the workaround; the errno
	     check is the fix, and this is what the fix bought. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/TextMate/</string>
		<string>/Library/Caches/com.j23software.TextMate-NG/</string>
	</array>

	<!-- Machine-wide bundle installs, the two non-home entries in
	     bundles::locations(). -->
	<key>com.apple.security.temporary-exception.files.absolute-path.read-only</key>
	<array>
		<string>/Library/Application Support/TextMate/</string>
	</array>

	<!-- The app's preference domain, for the theme choice. Verified to work from
	     inside the sandbox against a key that exists — the first attempt read two
	     keys that had never been set and "nil" was mistaken for a denial. -->
	<key>com.apple.security.temporary-exception.shared-preference.read-only</key>
	<array>
		<string>com.j23software.TextMate-NG</string>
	</array>
</dict>
</plist>
