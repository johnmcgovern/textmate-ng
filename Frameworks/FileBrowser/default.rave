target "${dirname}" {
	require MenuBuilder OakAppKit OakCommand OakFoundation TMFileReference Preferences bundles io ns regexp scm settings text
	headers src/FileBrowserViewController.h src/FileBrowserNotifications.h src/SCMManager.h

	files resources/* "Resources"

	sources src/*.{mm,swift} src/OFB/*.{mm,swift}
	tests tests/t_*.mm
	frameworks Cocoa
}
