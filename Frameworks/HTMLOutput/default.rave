target "${dirname}" {
	require OakAppKit OakFoundation OakSystem cf document io ns text
	headers src/HTMLOutput.h

	files resources/* "Resources"

	# `swift` is in the glob before any Swift exists, so the first ported file is a
	# port and nothing else. Harmless meanwhile: the brace list still matches the
	# .mm that are there.
	sources src/**/*.{cc,mm,swift}
	tests tests/t_*.{cc,mm}
	frameworks Cocoa WebKit
}
