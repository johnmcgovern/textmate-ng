#!/bin/zsh
# Exercise the Worker locally: start `wrangler dev`, post a report the way the
# application does, read it back, and check the refusals. No deploy, no network.
#
# Two dev runs, because ADMIN_TOKEN has to be both set and unset to cover /list:
# configured, it must refuse a wrong token and answer a right one; unconfigured,
# it must 404 like any unknown path rather than advertise itself with a 401.
set -e
cd "${0:h}/.."

port=8787
token='test-token-not-a-secret'

# miniflare persists its simulated R2 under .wrangler/state between runs, so
# without this the report count is cumulative and "one report was stored" passes
# or fails depending on how many times this script has been run before. Local
# dev state only; the deployed bucket is untouched.
rm -rf .wrangler/state

start_dev() { # port [extra wrangler args...]
	local p=$1; shift
	wrangler dev --port $p --local "$@" > /tmp/crash-collector-dev.log 2>&1 &
	dev_pid=$!
	for i in {1..40}; do
		curl -fsS "http://127.0.0.1:$p/" >/dev/null 2>&1 && return
		sleep 0.5
	done
}

echo "==> starting wrangler dev on :$port"
trap 'kill $dev_pid 2>/dev/null || true' EXIT
start_dev $port --var "ADMIN_TOKEN:$token"

fail=0
check() { # description expected actual
	if [[ "$2" == "$3" ]]; then echo "    ok    $1 ($3)"; else echo "    FAIL  $1: expected $2, got $3"; fail=1; fi
}

# A crash report has to look like one now, so the fixtures are built rather than
# printf'd: two JSON documents separated by a newline, the second carrying the
# codeSigningID and codeSigningTeamID the Worker checks. `ips <file> [key=value]`
# writes one, with overrides applied to whichever document holds that key.
ips() {
	local out=$1; shift
	python3 - "$out" "$@" <<'PY'
import gzip, json, sys
out, overrides = sys.argv[1], sys.argv[2:]
header = {
	"app_name": "TextMate-NG", "app_version": "2026.9-alpha.29", "name": "TextMate-NG",
	"bundleID": "com.j23software.TextMate-NG", "bug_type": "309",
	"incident_id": "B2738B33-8A69-4ADC-9472-025A39039829",
	"timestamp": "2026-09-18 12:00:00.00 -0700", "os_version": "macOS 27.0 (26A428)",
}
body = {
	"procName": "TextMate-NG", "codeSigningID": "com.j23software.TextMate-NG",
	"codeSigningTeamID": "R22V2H7QF4", "exception": {"type": "EXC_BAD_ACCESS"},
}
for override in overrides:
	key, _, value = override.partition("=")
	(header if key in header else body)[key] = value
with gzip.open(out, "wb") as f:
	f.write((json.dumps(header) + "\n" + json.dumps(body)).encode())
PY
}

report=$(mktemp -t crashreport).gz
ips "$report"

echo "==> a report, posted the way the application posts one"
headers=$(mktemp)
code=$(curl -s -o /tmp/crash-post.out -D "$headers" -w '%{http_code}' \
	-F "report=@$report;type=application/octet-stream" \
	-F 'hardware=MacBookPro18,2/arm64/10' \
	-F 'contact=Anonymous' \
	"http://127.0.0.1:$port/")
check "POST returns 201" 201 "$code"
location=$(grep -i '^location:' "$headers" | awk '{print $2}' | tr -d '\r')
[[ -n "$location" ]] && echo "    ok    Location: $location" || { echo "    FAIL  no Location header"; fail=1; }

echo "==> reading it back"
check "GET the report" 200 "$(curl -s -o /tmp/crash-get.out -w '%{http_code}' "$location")"
check "round trips" "$(gunzip -c "$report" | shasum -a 256 | cut -d' ' -f1)" "$(gunzip -c /tmp/crash-get.out 2>/dev/null | shasum -a 256 | cut -d' ' -f1)"

echo "==> the refusals"
check "no report part"     400 "$(curl -s -o /dev/null -w '%{http_code}' -F 'hardware=x' "http://127.0.0.1:$port/")"
check "not multipart"      400 "$(curl -s -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' -d '{}' "http://127.0.0.1:$port/")"
check "unknown report"     404 "$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$port/r/00000000-0000-4000-8000-000000000000")"
check "PUT not allowed"    405 "$(curl -s -o /dev/null -w '%{http_code}' -X PUT "http://127.0.0.1:$port/")"

big=$(mktemp)
dd if=/dev/zero of="$big" bs=1m count=3 2>/dev/null
check "oversized report"   413 "$(curl -s -o /dev/null -w '%{http_code}' -F "report=@$big" "http://127.0.0.1:$port/")"
rm -f "$big" "$headers"

echo "==> what is not a crash report from this application"
post() { curl -s -o /dev/null -w '%{http_code}' -F "report=@$1" -F 'hardware=x' -F 'contact=x' "http://127.0.0.1:$port/"; }

junk=$(mktemp); head -c 400 /dev/urandom > "$junk"
check "random bytes"       415 "$(post "$junk")"

notgzip=$(mktemp); ips "$notgzip"; gunzip -c "$notgzip" > "$notgzip.plain" 2>/dev/null
check "a report, ungzipped" 415 "$(post "$notgzip.plain")"

# Compresses ~1000:1, so it is small enough to pass the 2 MB wire cap and large
# enough to blow the 16 MB decompressed cap. The cap has to be enforced while
# decompressing; this is the test that says so.
bomb=$(mktemp); dd if=/dev/zero bs=1m count=64 2>/dev/null | gzip > "$bomb"
check "a gzip bomb"        415 "$(post "$bomb")"

text=$(mktemp); printf 'just some text\nand more of it\n' | gzip > "$text"
check "gzipped prose"      422 "$(post "$text")"

oneline=$(mktemp); printf '{"incident_id":"x","timestamp":"t","bug_type":"309"}' | gzip > "$oneline"
check "no second document" 422 "$(post "$oneline")"

wrongteam=$(mktemp).gz; ips "$wrongteam" codeSigningTeamID=XXXXXXXXXX
check "another team"       422 "$(post "$wrongteam")"

adhoc=$(mktemp).gz; ips "$adhoc" codeSigningTeamID=
check "an ad-hoc dev build" 422 "$(post "$adhoc")"

wrongapp=$(mktemp).gz; ips "$wrongapp" codeSigningID=com.apple.Safari
check "another application" 422 "$(post "$wrongapp")"

noheader=$(mktemp).gz; ips "$noheader" incident_id=
check "no incident_id"     422 "$(post "$noheader")"
rm -f "$junk" "$notgzip" "$notgzip.plain" "$bomb" "$text" "$oneline" "$wrongteam" "$adhoc" "$wrongapp" "$noheader"

echo "==> the listing, with ADMIN_TOKEN configured"
check "no token"           401 "$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$port/list")"
check "wrong token"        401 "$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer wrong" "http://127.0.0.1:$port/list")"
check "token as a prefix"  401 "$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer ${token:0:10}" "http://127.0.0.1:$port/list")"
check "right token"        200 "$(curl -s -o /tmp/crash-list.out -w '%{http_code}' -H "Authorization: Bearer $token" "http://127.0.0.1:$port/list")"
# The report posted above, and only it: one entry, and the contact string the
# client sent, which is the field the listing exists to show.
check "lists one report"   1 "$(python3 -c 'import json,sys; print(json.load(open("/tmp/crash-list.out"))["total"])')"
check "carries contact"    Anonymous "$(python3 -c 'import json,sys; print(json.load(open("/tmp/crash-list.out"))["reports"][0]["contact"])')"
# Read out of the report itself, not out of the form fields the POST supplied.
check "carries app version" 2026.9-alpha.29 "$(python3 -c 'import json,sys; print(json.load(open("/tmp/crash-list.out"))["reports"][0]["appVersion"])')"
check "no report body"     0 "$(grep -c 'Incident Identifier' /tmp/crash-list.out || true)"

echo "==> the listing, with no ADMIN_TOKEN — must not announce itself"
kill $dev_pid 2>/dev/null || true
wait $dev_pid 2>/dev/null || true
start_dev $port
check "unconfigured /list" 404 "$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$port/list")"
check "even with a token"  404 "$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $token" "http://127.0.0.1:$port/list")"

if [[ $fail == 0 ]]; then echo "==> all checks passed"; else echo "==> FAILURES; wrangler log at /tmp/crash-collector-dev.log"; fi
exit $fail
