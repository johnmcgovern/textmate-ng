#!/bin/sh
# Publish a notarized TextMate-NG.app as a GitHub Release.
#
# Usage: bin/release [path/to/TextMate-NG.app]
#   Defaults to build/Release/TextMate-NG.app.
#
#   --resign-manifest  republish the current manifest with a fresh expiry, and
#               nothing else — no build, no tag. Needs TM_CODE_SIGN_IDENTITY.
#   --dry-run   do everything except create the release (still builds and
#               verifies the zip, and prints the notes it would publish)
#
# This is the last mile that bin/notarize deliberately stops short of. Keeping it
# a separate script is the point: re-running a notarization is safe, and
# re-running "publish a public release" is not.
#
# What it does, in order:
#   1. verifies the app is Developer ID-signed, stapled, and accepted by
#      Gatekeeper — a release nobody can open is worse than no release
#   2. reads the version out of the app itself and checks it against the newest
#      heading in Changes.md and against the git tag it is about to publish to
#   3. packages with ditto, then **unpacks the package somewhere clean and
#      re-verifies it**, because the artifact people download is the zip, not the
#      directory it was made from
#   4. collects the dSYMs for exactly the binaries in that bundle, matched by
#      UUID, and refuses to publish if any of them is missing
#   5. creates the release, marked pre-release, with notes taken from Changes.md,
#      attaching the app zip and the dSYM zip
#
# Requires: gh, authenticated with repo scope (`gh auth status`).
#
# **Before running this, do the five-minute smoke pass** in
# ide/NEXT_SESSION_HANDOFF.md ("Before cutting a release"). Nothing in this script
# can tell you a whole window is dead on arrival — alpha.10 and alpha.11 both
# shipped with Settings crashing on open, and every check below passed for both.
set -e

APP="build/Release/TextMate-NG.app"
DRY_RUN=NO
RESIGN_ONLY=NO
for arg in "$@"; do
  case "$arg" in
    --dry-run)         DRY_RUN=YES     ;;
    --resign-manifest) RESIGN_ONLY=YES ;;
    *)                 APP="$arg"      ;;
  esac
done

ROOT=$(cd "$(dirname "$0")/.." && pwd)
CHANGES="$ROOT/Applications/TextMate/about/Changes.md"

command -v gh >/dev/null || { echo "error: gh not installed (brew install gh)" >&2; exit 1; }
gh auth status >/dev/null 2>&1 || { echo "error: gh is not authenticated (gh auth login)" >&2; exit 1; }

# ============================================================
# = 0. --resign-manifest: refresh the expiry, publish nothing =
# ============================================================
#
# The client refuses a manifest past its `expires`, which is what stops a CDN
# replaying a stale one forever. That protection has a cost: if more than a month
# goes by without a release, the *current* manifest lapses and every user is told
# the update check failed. This republishes the same manifest with new dates.
#
# It changes nothing about which build is offered — same version, same URL, same
# checksum — so it needs no app, no build and no tag.
if [ "$RESIGN_ONLY" = YES ]; then
  REPO=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
  WORK=$(mktemp -d)
  trap 'rm -rf "$WORK"' EXIT

  echo "==> fetching the published manifest"
  curl -fsSL "https://github.com/$REPO/releases/download/updates/release.json" -o "$WORK/current.json" || {
    echo "error: no published manifest to refresh" >&2; exit 1; }

  python3 - "$WORK/current.json" "$WORK/inner.json" <<'REFRESH'
import sys, json, base64, datetime
wrapper = json.load(open(sys.argv[1]))
inner = json.loads(base64.b64decode(wrapper["manifest"]))
now = datetime.datetime.now(datetime.timezone.utc)
inner["issued"]  = now.strftime("%Y-%m-%dT%H:%M:%SZ")
inner["expires"] = (now + datetime.timedelta(days=35)).strftime("%Y-%m-%dT%H:%M:%SZ")
# separators matter only in that the bytes written here are the bytes signed;
# the client verifies before parsing and never re-serialises.
open(sys.argv[2], "w").write(json.dumps(inner, separators=(",", ":")))
print("    version %s, expires %s" % (inner["version"], inner["expires"]))
REFRESH

  # No app to take the identity from here, so it must come from the environment.
  # Without it the tool is rebuilt ad-hoc and the keychain prompts, which in a
  # script is a hang rather than an error.
  [ -n "$TM_CODE_SIGN_IDENTITY" ] || {
    echo "error: set TM_CODE_SIGN_IDENTITY so bin/update-sign is built with the identity the key's ACL expects" >&2
    echo "       TM_CODE_SIGN_IDENTITY=\"Developer ID Application: … (TEAMID)\" bin/release --resign-manifest" >&2
    exit 1; }
  export TM_CODE_SIGN_IDENTITY

  SIG=$("$ROOT/bin/update-sign" sign "$WORK/inner.json")
  MANIFEST="$ROOT/build/release.json"
  mkdir -p "$ROOT/build"
  printf '{"manifest":"%s","keyID":"j23-2026","signature":"%s"}' \
    "$(base64 -i "$WORK/inner.json" | tr -d '\n')" "$SIG" > "$MANIFEST"

  "$ROOT/bin/update-sign" verify "$MANIFEST" || {
    echo "error: the refreshed manifest does not verify" >&2; exit 1; }

  if [ "$DRY_RUN" = YES ]; then
    echo "==> --dry-run: not uploading. Refreshed manifest at $MANIFEST"
    exit 0
  fi

  gh release upload updates "$MANIFEST" --clobber
  echo "==> done: https://github.com/$REPO/releases/download/updates/release.json"
  exit 0
fi

[ -d "$APP" ] || { echo "error: $APP not found (build Release first)" >&2; exit 1; }

# ============================================================
# = 1. The app has to be something a stranger can actually open =
# ============================================================

echo "==> verifying $APP"
codesign --verify --deep --strict "$APP" || {
  echo "error: $APP fails codesign verification" >&2; exit 1; }
codesign -dvv "$APP" 2>&1 | grep -q '^Authority=Developer ID Application' || {
  echo "error: $APP is not Developer ID-signed (ad-hoc?) — run bin/notarize first" >&2; exit 1; }
xcrun stapler validate "$APP" >/dev/null 2>&1 || {
  echo "error: $APP has no stapled notarization ticket — run bin/notarize first" >&2; exit 1; }
spctl --assess --type execute "$APP" >/dev/null 2>&1 || {
  echo "error: Gatekeeper does not accept $APP" >&2; exit 1; }

# No binary in the shipped app may relax library validation. With it relaxed,
# the application loads code that is not signed by its own team — which is how a
# plug-in dropped into the user-writable PlugIns folder ran inside alpha.34. The
# seed strips it for Developer ID builds; this is the check that it did, over
# every Mach-O in the bundle rather than only the main executable.
RELAXED=$(find "$APP/Contents" -type f -perm +111 2>/dev/null | while read -r f; do
  file -b "$f" | grep -q 'Mach-O' || continue
  codesign -d --entitlements - --xml "$f" 2>/dev/null | grep -q 'disable-library-validation' && echo "${f#$APP/}"
done)
[ -z "$RELAXED" ] || {
  echo "error: these binaries relax library validation, which a release must not:" >&2
  printf '         %s\n' $RELAXED >&2
  echo "       re-seed with TM_CODE_SIGN_IDENTITY set, then rebuild" >&2
  exit 1; }

# The bundles a first run unpacks have to be the ones currently published.
#
# The build restages them only when the published index changes, and records the
# index it staged from beside the archive. This compares that record with the
# index live right now. It exists because alpha.33 shipped an archive staged the
# night before a mirror fix: every check above passed, the app was perfectly
# signed, and a fresh install still started with the broken Bundle Support. A
# stamp of "offline" means the build staged nothing, which is never releasable.
STAMP="$APP/Contents/Resources/DefaultBundles.index-sha256"
[ -s "$STAMP" ] || {
  echo "error: $APP carries no DefaultBundles.index-sha256 — rebuild with the current seed" >&2; exit 1; }
STAGED=$(cat "$STAMP")
[ "$STAGED" != "offline" ] || {
  echo "error: $APP was built offline and embeds no bundles — rebuild with a network" >&2; exit 1; }
PUBLISHED=$("$ROOT/bin/stage-bundles" --print-index-digest) || {
  echo "error: could not read the published bundle index to compare against" >&2; exit 1; }
[ "$STAGED" = "$PUBLISHED" ] || {
  echo "error: $APP embeds bundles staged from index ${STAGED%${STAGED#????????????}}," >&2
  echo "       but the published index is ${PUBLISHED%${PUBLISHED#????????????}} — rebuild so a first run gets the current bundles" >&2
  exit 1; }

# ============================================================
# = 2. Version, three ways, and they have to agree           =
# ============================================================

VERSION=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$APP/Contents/Info.plist")
TAG="v$VERSION"

# The newest `## <date> (vX)` heading — the same expression ide/seed_xcodeproj.rb
# uses to stamp the app, so a disagreement means the app was built before the
# heading was written.
NOTES_VERSION=$(sed -n 's/^## .* (v\(.*\))$/\1/p' "$CHANGES" | head -1)
[ "$VERSION" = "$NOTES_VERSION" ] || {
  echo "error: app is $VERSION but the newest Changes.md heading is $NOTES_VERSION" >&2
  echo "       (rebuild after adding the heading — the heading *is* the version bump)" >&2
  exit 1; }

# The heading states a date and a version on the same line, and under calendar
# versioning their year.month has to be the same thing said twice.
#
# This exists because it was not the same thing said twice for nine releases.
# alpha.3 through alpha.11 all shipped as 2026.7 while dated August — the drift
# started on 2026-08-02 and nothing noticed until after alpha.11 was published,
# because the only thing that could have caught it was remembering, every time.
# Fixed forward rather than retagging; see the versioning bullet in the alpha.1
# entry of Changes.md.
NOTES_DATE=$(sed -n 's/^## \([0-9][0-9-]*\) (v.*)$/\1/p' "$CHANGES" | head -1)
NOTES_YM=$(printf '%s' "$NOTES_DATE" | sed 's/^\([0-9]*\)-0*\([0-9]*\)-.*$/\1.\2/')
VERSION_YM=$(printf '%s' "$VERSION" | sed 's/^\([0-9]*\.[0-9]*\).*$/\1/')
[ "$VERSION_YM" = "$NOTES_YM" ] || {
  echo "error: version $VERSION says $VERSION_YM but the heading is dated $NOTES_DATE ($NOTES_YM)" >&2
  echo "       calendar versioning means the version carries the month it shipped in;" >&2
  echo "       bump the heading to v$NOTES_YM-<suffix>, re-seed, and rebuild" >&2
  exit 1; }

git -C "$ROOT" rev-parse "$TAG" >/dev/null 2>&1 || {
  echo "error: no git tag $TAG — tag the release commit first" >&2; exit 1; }

# Locally is not enough: `gh release create` resolves the tag on the *remote*,
# and refuses an unpushed one. Found by hitting it — the first alpha.8 attempt
# got all the way through packaging and notarisation checks before failing here,
# which is a slow way to learn you forgot `git push --tags`.
REMOTE=$(git -C "$ROOT" config --get "branch.$(git -C "$ROOT" rev-parse --abbrev-ref HEAD).remote" || echo origin)
git -C "$ROOT" ls-remote --tags --exit-code "$REMOTE" "refs/tags/$TAG" >/dev/null 2>&1 || {
  echo "error: tag $TAG is not on $REMOTE — git push $REMOTE $TAG" >&2; exit 1; }

if gh release view "$TAG" >/dev/null 2>&1; then
  echo "error: release $TAG already exists — delete it or bump the version" >&2; exit 1
fi

# CI, on the exact commit this tag points at.
#
# **This exists because it did not.** v2026.9-alpha.31 was tagged, notarized and
# published from a commit that CI could not compile, and had been red for six
# commits before it. Nothing noticed, because everything else here checks the
# *artifact* — which was fine, being built on the release Mac — and nothing
# checked the one signal that sees what the release Mac cannot. CI pins Xcode
# 26.6 and this machine has 27; they disagree about Swift 6 concurrency, so a
# green local build is not evidence about CI and never was.
#
# The commit, not the branch: `gh run list` without --commit answers about
# whatever ran most recently, which on a busy day is not the thing being
# released.
TAG_SHA=$(git -C "$ROOT" rev-parse "$TAG^{commit}")
echo "==> checking CI on ${TAG_SHA%${TAG_SHA#????????}}"
# Every run on this commit, not just the newest.
#
# Pushing the tag starts a second run on the same bytes as the branch push, so
# `--limit 1` answers "in progress" about a duplicate of a run that already
# passed — which is how this refused a release thirty seconds after allowing it.
# A completed failure still refuses, including a failed re-run of something that
# passed before, because that is exactly the case worth hearing about.
#
# `.[0]` on an empty array is null and interpolates to the string "null", so the
# never-ran case has to be spelled out or it reads as a bug in this script.
CI_RUNS=$(gh run list --commit "$TAG_SHA" --workflow=build.yml --limit 20 \
            --json status,conclusion -q '.[] | "\(.status):\(.conclusion // "")"' 2>/dev/null || echo "")
CI_FAILED=$(printf '%s\n' "$CI_RUNS" | grep -c '^completed:' | head -1 >/dev/null; \
            printf '%s\n' "$CI_RUNS" | grep '^completed:' | grep -cv '^completed:success$' || true)
CI_PASSED=$(printf '%s\n' "$CI_RUNS" | grep -c '^completed:success$' || true)
CI_RUNNING=$(printf '%s\n' "$CI_RUNS" | grep -c -v '^completed:' || true)

if [ -z "$CI_RUNS" ] || [ "$CI_RUNS" = "null" ]; then
  echo "error: CI has never run on $TAG_SHA." >&2
  echo "  Push the branch and let it finish before releasing." >&2
  exit 1
elif [ "$CI_FAILED" -gt 0 ]; then
  echo "error: $CI_FAILED CI run(s) failed on $TAG_SHA — refusing to publish." >&2
  echo "  gh run list --commit $TAG_SHA" >&2
  echo "  A release built on this Mac can pass every check here and still be a" >&2
  echo "  commit nobody else can build. That is what alpha.31 was." >&2
  exit 1
elif [ "$CI_PASSED" -gt 0 ]; then
  echo "    CI passed on this commit ($CI_PASSED run(s); $CI_RUNNING still going on the same bytes)"
else
  echo "error: CI is still running on $TAG_SHA and none has passed yet — wait for it." >&2
  exit 1
fi

echo "==> releasing $TAG"

# ============================================================
# = 3. Package, then verify the package                      =
# ============================================================

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

ZIP="$ROOT/build/TextMate-NG-$VERSION.zip"
echo "==> packaging $(basename "$ZIP")"
rm -f "$ZIP"
ditto -c -k --keepParent "$APP" "$ZIP"

# The artifact people download is the zip. build/ has held stale bundles before,
# and --keepParent means the zip's contents are not self-evidently the app that
# was just verified — so unpack it somewhere clean and check it again.
echo "==> verifying the packaged copy"
ditto -x -k "$ZIP" "$WORK/unpacked"
UNPACKED="$WORK/unpacked/TextMate-NG.app"
[ -d "$UNPACKED" ] || { echo "error: zip does not contain TextMate-NG.app at its root" >&2; exit 1; }

UNPACKED_VERSION=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$UNPACKED/Contents/Info.plist")
[ "$UNPACKED_VERSION" = "$VERSION" ] || {
  echo "error: packaged app is $UNPACKED_VERSION, expected $VERSION" >&2; exit 1; }
xcrun stapler validate "$UNPACKED" >/dev/null 2>&1 || {
  echo "error: the packaged copy has no stapled ticket (staple before packaging)" >&2; exit 1; }
spctl --assess --type execute "$UNPACKED" >/dev/null 2>&1 || {
  echo "error: Gatekeeper does not accept the packaged copy" >&2; exit 1; }

echo "    $(du -h "$ZIP" | cut -f1), $VERSION, stapled, Gatekeeper-accepted"

# ============================================================
# = 4. The dSYMs for exactly these binaries                  =
# ============================================================

# Release builds are stripped (see the Release block in ide/seed_xcodeproj.rb),
# so a crash report from a published build is only fully readable against the
# dSYM that was produced alongside it — and those live in build/, which is
# gitignored and routinely deleted. Publishing them as a second asset is what
# makes them outlive the build directory.
#
# Matched by UUID rather than by filename, which is the whole point rather than a
# nicety: build/ accumulates dSYMs from earlier builds, and a *stale* dSYM is
# worse than no dSYM, because it resolves addresses to confident wrong answers.
# This project has already had dSYMs sitting two weeks older than the binaries
# next to them without anything noticing.

BUILT=$(cd "$(dirname "$APP")" && pwd)
DSYM_ZIP="$ROOT/build/TextMate-NG-$VERSION-dSYMs.zip"

echo "==> collecting dSYMs"

# Every UUID that has a dSYM sitting beside the app, and where it lives.
: > "$WORK/dsym-index"
for d in "$BUILT"/*.dSYM; do
  [ -d "$d" ] || continue
  for img in "$d"/Contents/Resources/DWARF/*; do
    [ -f "$img" ] || continue
    dwarfdump --uuid "$img" 2>/dev/null | awk -v p="$d" '/^UUID:/ { print $2, p }' >> "$WORK/dsym-index"
  done
done

# Every Mach-O actually inside the bundle — by executable bit rather than by a
# list of paths, so a helper nested somewhere new cannot quietly go unsymbolicated.
# dwarfdump prints nothing for a non-Mach-O, which is the filter for shell scripts.
: > "$WORK/dsym-wanted"
: > "$WORK/dsym-missing"
find "$APP" -type f -perm -u+x | while IFS= read -r bin; do
  uuid=$(dwarfdump --uuid "$bin" 2>/dev/null | awk '/^UUID:/ { print $2; exit }')
  [ -n "$uuid" ] || continue
  match=$(awk -v u="$uuid" '$1 == u { print $2; exit }' "$WORK/dsym-index")
  if [ -n "$match" ]; then
    echo "$match" >> "$WORK/dsym-wanted"
  else
    echo "${bin#"$APP"/} ($uuid)" >> "$WORK/dsym-missing"
  fi
done

# Nothing matched and nothing missing means the walk found no Mach-O at all,
# which is not "no dSYMs needed" — it is a bad $APP. Without this the script
# sails on and fails later with an empty archive, which does not point anywhere.
if [ ! -s "$WORK/dsym-wanted" ] && [ ! -s "$WORK/dsym-missing" ]; then
  echo "error: found no Mach-O binaries inside $APP — is that a real app bundle?" >&2
  exit 1
fi

if [ -s "$WORK/dsym-missing" ]; then
  echo "error: no dSYM matches these shipped binaries:" >&2
  sed 's/^/       /' "$WORK/dsym-missing" >&2
  echo "       Release sets DEBUG_INFORMATION_FORMAT=dwarf-with-dsym, so a full" >&2
  echo "       rebuild writes them beside the app. A dSYM whose UUID does not" >&2
  echo "       match is not a near miss — it is a different build." >&2
  exit 1
fi

rm -f "$DSYM_ZIP"
sort -u "$WORK/dsym-wanted" | sed "s|^$BUILT/||" > "$WORK/dsym-names"
while IFS= read -r name; do
  (cd "$BUILT" && zip -qr9 "$DSYM_ZIP" "$name")
done < "$WORK/dsym-names"
[ -s "$DSYM_ZIP" ] || { echo "error: dSYM archive came out empty" >&2; exit 1; }

echo "    $(wc -l < "$WORK/dsym-names" | tr -d ' ') dSYMs, $(du -h "$DSYM_ZIP" | cut -f1), all UUID-matched to the packaged app"

# ============================================================
# = 4.5 The update payload, and its signed manifest          =
# ============================================================

TBZ="$ROOT/build/TextMate-NG-$VERSION.tbz"
echo "==> packaging $(basename "$TBZ") for the updater"
rm -f "$TBZ"

# From "$WORK/unpacked", not from build/: that is the copy already checked for
# signature, staple and Gatekeeper acceptance a few steps up. Packaging the
# updater's payload from anywhere else would mean shipping something less
# verified than the zip beside it.
#
# One top-level TextMate-NG.app, because the updater extracts with
# `tar -jxmkC <dir> --strip-components 1`, which makes <dir> the application
# itself. Change the layout here and the installed app becomes a directory
# containing an app.
tar -cjf "$TBZ" -C "$WORK/unpacked" TextMate-NG.app

TBZ_SHA=$(shasum -a 256 "$TBZ" | cut -d' ' -f1)
TBZ_SIZE=$(stat -f %z "$TBZ")
REPO=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
TBZ_URL="https://github.com/$REPO/releases/download/$TAG/$(basename "$TBZ")"

# 35 days. The client refuses an expired manifest, which is what stops a CDN
# replaying a stale-but-validly-signed one forever and pinning users to a build
# with a known hole. If more than a month passes without a release, run
# `bin/release --resign-manifest` rather than letting it lapse.
ISSUED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EXPIRES=$(date -u -v+35d +%Y-%m-%dT%H:%M:%SZ)

# **Read out of the app, never written here.** This used to be the literal "15.0",
# a second copy of ide/seed_xcodeproj.rb's DEPLOY_TGT with nothing keeping the two
# in step — and the client *enforces* this field as of 5882b2d5, which is what makes
# a stale copy dangerous rather than untidy.
#
# Raise DEPLOY_TGT for a new macOS and the hardcoded version would have offered the
# build to everyone the app can no longer launch on: manifest says 15.0, bundle says
# it needs 26, so the update installs and then macOS refuses to start it — with the
# application that could have explained why already replaced. That is the exact
# failure the enforcement exists to prevent, defeated by a copy of a number.
APP_MIN_OS=$(/usr/libexec/PlistBuddy -c 'Print :LSMinimumSystemVersion' "$UNPACKED/Contents/Info.plist" 2>/dev/null)
[ -n "$APP_MIN_OS" ] || {
  echo "error: $UNPACKED has no LSMinimumSystemVersion; refusing to guess one" >&2; exit 1; }

# The plist is what macOS consults when deciding whether to launch; LC_BUILD_VERSION's
# minos is what dyld enforces. They come from different build settings and are
# supposed to agree — if they do not, this build is inconsistent and whichever one
# the manifest copied would be wrong.
BIN_MIN_OS=$(otool -l "$UNPACKED/Contents/MacOS/TextMate-NG" 2>/dev/null \
  | awk '/LC_BUILD_VERSION/{f=1} f&&/^ *minos/{print $2; exit}')
[ "$APP_MIN_OS" = "$BIN_MIN_OS" ] || {
  echo "error: LSMinimumSystemVersion is $APP_MIN_OS but the binary's minos is $BIN_MIN_OS" >&2
  echo "       these must agree; the manifest would advertise the wrong floor" >&2
  exit 1; }

INNER="$WORK/manifest-inner.json"
printf '{"version":"%s","url":"%s","sha256":"%s","size":%s,"issued":"%s","expires":"%s","minimumSystemVersion":"%s"}' \
  "$VERSION" "$TBZ_URL" "$TBZ_SHA" "$TBZ_SIZE" "$ISSUED" "$EXPIRES" "$APP_MIN_OS" > "$INNER"

echo "==> signing the update manifest"

# The signing key's keychain ACL is bound to a Developer ID-signed
# bin/update-sign. Rebuild that tool ad-hoc — which happens the first time after
# anyone edits update-sign.swift — and macOS puts up an access prompt instead of
# signing, which in a script means it **hangs**. Cost two minutes to discover.
#
# So take the identity from the application this script has already verified,
# rather than hoping the environment carries it: same certificate that signed the
# app, which is exactly the ACL the key was created under.
TM_CODE_SIGN_IDENTITY=$(codesign -dvv "$APP" 2>&1 | sed -n 's/^Authority=\(Developer ID Application: .*\)$/\1/p' | head -1)
[ -n "$TM_CODE_SIGN_IDENTITY" ] || {
  echo "error: could not read a Developer ID from $APP to sign the manifest with" >&2; exit 1; }
export TM_CODE_SIGN_IDENTITY

SIG=$("$ROOT/bin/update-sign" sign "$INNER") || {
  echo "error: could not sign the manifest — is the signing key present? (bin/update-sign public-key)" >&2; exit 1; }

# The inner document travels base64-encoded and the signature covers those exact
# bytes, so the client verifies before it parses and neither side has to agree
# about JSON whitespace or key order.
MANIFEST="$ROOT/build/release.json"
printf '{"manifest":"%s","keyID":"j23-2026","signature":"%s"}' \
  "$(base64 -i "$INNER" | tr -d '\n')" "$SIG" > "$MANIFEST"

# The application and the publisher have to agree about *where* the manifest
# lives, and nothing connects them but two literals in two languages. If they
# drift, the manifest is fine, the signature is fine, and every user's update
# check quietly 404s — which is the kind of failure nobody notices for a month,
# because a working updater and a silent one look identical from the outside.
# So: the app being released must be asking for the URL this release publishes to.
MANIFEST_URL="https://github.com/$REPO/releases/download/updates/release.json"
grep -qF "$MANIFEST_URL" "$ROOT/Applications/TextMate/src/AppController.swift" || {
  echo "error: AppController.swift does not name $MANIFEST_URL" >&2
  echo "       the application in this release would look for its manifest elsewhere" >&2
  exit 1; }

# Check what was just produced, because a release whose manifest does not verify
# is worse than no release: every user gets an integrity error and no way to tell
# it from an attack.
echo "==> verifying the manifest"
"$ROOT/bin/update-sign" verify "$MANIFEST" || {
  echo "error: the manifest just written does not verify" >&2; exit 1; }
echo "    $(du -h "$TBZ" | cut -f1) payload, sha256 ${TBZ_SHA%${TBZ_SHA#????????}}…, expires $EXPIRES"

# ============================================================
# = 5. Notes, from the file that already has them            =
# ============================================================

# Everything between the newest `## ` heading and the next one. Changes.md is
# written for a reader rather than a committer, so it is the release note — there
# is nothing to write a second time.
NOTES="$WORK/notes.md"
awk '/^## /{ if(seen) exit; seen=1; next } seen' "$CHANGES" > "$NOTES"

# The requirements do not appear in Changes.md, and a release page that omits
# them produces a bug report from an Intel Mac.
#
# The Requirements line is printf'd instead of living in the heredoc, because it has
# to expand $APP_MIN_OS and the heredoc has to stay **quoted**: its body contains
# `/Applications` and `-dSYMs.zip` in backticks, which an unquoted heredoc would run
# as commands. Writing it in the heredoc and unquoting the delimiter is the obvious
# move and produces a release page with the output of `/Applications` in it.
printf '\n---\n\n**Requirements:** Apple Silicon, macOS %s or later.\n' "$APP_MIN_OS" >> "$NOTES"

cat >> "$NOTES" <<'REQUIREMENTS'

Unzip and drag to `/Applications`. The build is signed with an Apple Developer ID
and notarized, so Gatekeeper accepts it with no workaround — if macOS refuses to
open it, that is a real signal rather than something to work around.

This is an alpha, but it can update itself: it checks for new releases and installs
them after asking you.

If it crashes, it can send the report to this project's own collector — but only
after asking, once, the first time there is something to send, and never for a
build you compiled yourself. A report carries the code that was running, your
Mac's model and the contact details in Settings; not what you were editing.
Settings ▸ Software Update turns it off before it ever asks. macOS's own crash
reporting is unaffected either way.

The `-dSYMs.zip` asset is debug symbols for this exact build — only useful for
turning a crash report into readable function names. **The app is the other
one.**
REQUIREMENTS

if [ "$DRY_RUN" = YES ]; then
  echo "==> --dry-run: not creating the release. Notes would be:"
  echo "----------------------------------------------------------------"
  cat "$NOTES"
  echo "----------------------------------------------------------------"
  echo "==> zip left at $ZIP"
  echo "==> dSYMs left at $DSYM_ZIP"
  echo "==> updater payload left at $TBZ"
  echo "==> signed manifest (verified, not published):"
  echo "----------------------------------------------------------------"
  cat "$INNER"; echo
  echo "----------------------------------------------------------------"
  exit 0
fi

# --prerelease on purpose: these are alphas, and it keeps "Latest release" honest
# for whenever a non-alpha appears.
echo "==> creating GitHub release $TAG"
gh release create "$TAG" "$ZIP" "$DSYM_ZIP" "$TBZ" \
  --title "TextMate-NG $VERSION" \
  --notes-file "$NOTES" \
  --prerelease

# The manifest lives on a rolling release, so the URL the application is built
# with never changes:
#
#   https://github.com/<owner>/<repo>/releases/download/updates/release.json
#
# A release asset rather than GitHub Pages, which needs no branch and no Pages
# setup. It is served as application/octet-stream, which is fine — the client
# treats Content-Type as advisory, because the signature is the authority and the
# transport is not (see a96f759b).
echo "==> publishing the update manifest"
if ! gh release view updates >/dev/null 2>&1; then
  gh release create updates \
    --title "Update manifest" \
    --notes "The current update manifest, replaced by each release. Not a build — see the versioned releases for those." \
    --prerelease
fi
gh release upload updates "$MANIFEST" --clobber

echo "==> done: $(gh release view "$TAG" --json url --jq .url)"
echo "==> manifest: $MANIFEST_URL"
